# Server-side env vars read by the Vercel functions in api/ (and the backend/ services they load).
# Deployed values live in the Vercel project env; locally run `vercel env pull .env.local`.
# Frontend VITE_ vars are in frontend/.env.example. Never commit real values.

# Firebase Admin service account (api/_lib/firebase.js)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# YNAB OAuth app (api/_lib/ynab.js, backend/services/newsletterService.js)
YNAB_CLIENT_ID=your-ynab-client-id
YNAB_CLIENT_SECRET=your-ynab-client-secret
YNAB_REDIRECT_URI=http://localhost:5173/auth/ynab/callback

# Newsletter cron auth: bearer token for /api/newsletter (api/newsletter.js)
CRON_SECRET=your-cron-secret

# Newsletter email via Resend (backend/services/emailService.js)
RESEND_API_KEY=your-resend-api-key
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev
NEWSLETTER_RECIPIENTS=you@example.com,partner@example.com
NEWSLETTER_TIMEZONE=America/Los_Angeles
FRONTEND_URL=http://localhost:5173

# AI analysis (backend/services/aiAnalysisService.js)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Logging (backend/logger.js); optional, defaults to info
LOG_LEVEL=info
