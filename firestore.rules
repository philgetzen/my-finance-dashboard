rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A written document must name the writer as owner in user_id and, if
    // present, in userId. The API routes trust both fields, so a client must
    // not be able to create or update a document that names someone else.
    function claimsOnlySelf() {
      return request.resource.data.user_id == request.auth.uid
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
    }

    // YNAB tokens - users can only access their own tokens
    match /ynab_tokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Manual accounts - users can only access their own accounts
    match /manual_accounts/{accountId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && claimsOnlySelf();
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid && claimsOnlySelf();
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // User holdings - users can only access their own holdings
    match /user_holdings/{holdingId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && claimsOnlySelf();
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid && claimsOnlySelf();
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // CSP Settings - users can only access their own settings
    // Document ID is the user's UID
    match /csp_settings/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
